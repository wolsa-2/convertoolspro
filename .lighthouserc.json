{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:4173/",
        "http://localhost:4173/about",
        "http://localhost:4173/tool/jpg-to-pdf",
        "http://localhost:4173/tool/merge-pdf",
        "http://localhost:4173/tool/split-pdf",
        "http://localhost:4173/tool/rotate-pdf",
        "http://localhost:4173/tool/watermark-pdf",
        "http://localhost:4173/tool/pdf-metadata",
        "http://localhost:4173/tool/image-placeholder",
        "http://localhost:4173/tool/image-to-base64",
        "http://localhost:4173/blog"
      ],
      "numberOfRuns": 1,
      "startServerCommand": "npm run preview -- --host 127.0.0.1",
      "startServerReadyPattern": "Local:",
      "settings": {
        "saveAssets": true
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}